<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp"
      tools:context=".vas.VasReaderStatusActivity">

    <ImageView
        android:id="@+id/image_contactless"
        android:layout_width="148dp"
        android:layout_height="74dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:src="@drawable/contactless_black" />

    <TextView
        android:id="@+id/text_vas_status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="VAS Reader"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_vas_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Client disconnected. Tap Connect Client."
        android:textSize="16sp" />

    <EditText
        android:id="@+id/edit_pass_type_ids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="top|start"
        android:hint="Enter one or more PK passTypeId values&#10;Example: pass.com.passkit.pksamples.nfcdemo"
        android:inputType="textMultiLine"
        android:maxLines="3" />

    <Button
        android:id="@+id/button_connect_client"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Connect Client" />

    <Button
        android:id="@+id/button_start_vas_read"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:text="Start VAS Read" />

  <Button
      android:id="@+id/button_cancel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="8dp"
      android:text="Cancel"
      android:textSize="20sp" />

  </LinearLayout>


</ScrollView>

